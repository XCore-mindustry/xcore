# ~/.config/xcore/map-renderer.env, read by ops/systemd/xcore-map-renderer.service.
# A JDK or JRE 25; the start script uses $JAVA_HOME/bin/java.
JAVA_HOME=/opt/jdk-25
# The same Redis as the bot and the game servers.
MAP_RENDERER_REDIS_URL=redis://127.0.0.1:6379
# /ready and /metrics; ops/deploy checks /ready here.
MAP_RENDERER_HTTP=127.0.0.1:9471
# Renders at a time, renders waiting (beyond: "busy"), disk cache size.
MAP_RENDERER_CONCURRENCY=2
MAP_RENDERER_QUEUE=4
MAP_RENDERER_CACHE_MB=1024
