{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:shared:types:map-discord-upload:v1",
  "title": "MapDiscordUploadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uploadedBy",
    "uploadedAt"
  ],
  "properties": {
    "uploadedBy": {
      "$ref": "urn:xcore:protocol:shared:types:discord-identity-ref:v1"
    },
    "uploadedAt": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "creator": {
      "$ref": "urn:xcore:protocol:shared:types:discord-identity-ref:v1"
    },
    "uploadedByHandle": {
      "type": "string",
      "minLength": 1
    },
    "creatorHandle": {
      "type": "string",
      "minLength": 1
    },
    "caseNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "The map review (case) that accepted this file."
    },
    "threadId": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$",
      "description": "The Discord forum post of that review."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Which reviewed revision of the post this file is."
    },
    "fixedBy": {
      "$ref": "urn:xcore:protocol:shared:types:discord-identity-ref:v1",
      "description": "Who fixed someone else's map; creator stays its creator."
    },
    "fixedByHandle": {
      "type": "string",
      "minLength": 1
    }
  }
}
