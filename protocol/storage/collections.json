          "plugins/xcore/src/main/java/org/xcore/plugin/database/repository/GameDataRepository.java",
          "plugins/xcore/src/main/java/org/xcore/plugin/service/stats/PlayerTotalsStore.java"
        ],
        "bot": ["services/discord-bot/src/xcore_discord_bot/game_stats.py"],
        "web": ["web/src/lib/server/stats.ts"]
      },
      "notes": [
        "The bot's account merge rewrites player_stats.$[].uuid. stats_category values are shared with the bot and the website (V10 added TOWER_DEFENSE and RVSB)."
      ]
    },
