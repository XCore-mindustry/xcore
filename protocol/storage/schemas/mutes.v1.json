{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:storage:mutes:v1",
  "title": "mutes",
  "description": "At most one mute per player uuid; both writers replace the document by uuid and unmuting deletes it.",
  "x-collection": "mutes",
  "x-owner": "plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["_id", "uuid", "name", "admin_name", "reason", "expire_date"],
  "properties": {
    "_id": {
      "$ref": "urn:xcore:storage:bson-types:v1#/$defs/objectId",
      "description": "The plugin decodes mutes into a POJO whose id is an ObjectId.",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/database/repository/MuteDataRepository.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/punishment_store.py"]
      },
      "x-read-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/database/repository/MuteDataRepository.java"]}
    },
    "uuid": {
      "type": "string",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": [
          "services/discord-bot/src/xcore_discord_bot/punishment_store.py",
          "services/discord-bot/src/xcore_discord_bot/account_merge_store.py"
        ]
      },
      "x-read-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/store_mappers.py", "services/discord-bot/src/xcore_discord_bot/mongo_store.py"]
      },
      "x-fallback": {"bot": "MuteDoc requires it: find_mute raises on a mute without uuid"}
    },
    "pid": {
      "oneOf": [{"$ref": "urn:xcore:storage:bson-types:v1#/$defs/int32"}, {"type": "null"}],
      "description": "Written by the bot only.",
      "x-disagreement": "The plugin's MuteData has no pid: the plugin never writes it, and a mute the plugin replaces (a new mute for the same player, or an account merge) loses the pid the bot wrote.",
      "x-written-by": {
        "bot": [
          "services/discord-bot/src/xcore_discord_bot/punishment_store.py",
          "services/discord-bot/src/xcore_discord_bot/account_merge_store.py"
        ]
      },
      "x-read-by": {"bot": ["services/discord-bot/src/xcore_discord_bot/store_mappers.py"]},
      "x-fallback": {"bot": "None when missing or the sentinel"}
    },
    "case_number": {
      "oneOf": [{"$ref": "urn:xcore:storage:bson-types:v1#/$defs/int32"}, {"type": "null"}],
      "description": "Written by the bot only.",
      "x-disagreement": "The plugin's MuteData has no case_number, so a mute the plugin replaces loses its case link (bans keep it: BanData has the field).",
      "x-written-by": {"bot": ["services/discord-bot/src/xcore_discord_bot/punishment_store.py"]},
      "x-read-by": {"bot": ["services/discord-bot/src/xcore_discord_bot/store_mappers.py"]},
      "x-fallback": {"bot": "None when missing or 0"}
    },
    "name": {
      "type": "string",
