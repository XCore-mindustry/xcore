      "$ref": "urn:xcore:storage:bson-types:v1#/$defs/int64",
      "x-written-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]},
      "x-read-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]}
    },
    "deleted_at": {
      "$ref": "urn:xcore:storage:bson-types:v1#/$defs/int64",
      "x-written-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]},
      "x-read-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]}
    },
    "is_visible": {
      "type": "boolean",
      "x-written-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]},
      "x-read-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]}
    },
    "visible": {
      "type": "boolean",
      "description": "A second copy of is_visible from Lombok's isVisible() getter. Nothing reads it.",
      "x-written-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]}
    },
    "version": {
      "$ref": "urn:xcore:storage:bson-types:v1#/$defs/integer",
      "description": "Always 1. Not a schema version. int64 from the plugin's model; int32 on documents V1 back-filled.",
      "x-written-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]},
      "x-read-by": {"plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/ModelData.java"]}
