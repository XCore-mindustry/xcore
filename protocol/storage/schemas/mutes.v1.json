      "x-read-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/store_mappers.py", "services/discord-bot/src/xcore_discord_bot/mongo_store.py"]
      },
      "x-fallback": {"plugin": "\"Unknown\"", "bot": "MuteDoc requires it; \"Unknown\" when blank"}
