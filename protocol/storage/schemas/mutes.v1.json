        "bot": ["services/discord-bot/src/xcore_discord_bot/store_mappers.py"]
      },
      "x-fallback": {"plugin": "\"\"", "bot": "None when missing or blank"}
    },
    "reason": {
      "type": "string",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": [
          "services/discord-bot/src/xcore_discord_bot/punishment_store.py",
          "services/discord-bot/src/xcore_discord_bot/account_merge_store.py"
        ]
      },
      "x-read-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": [
          "services/discord-bot/src/xcore_discord_bot/store_mappers.py",
          "services/discord-bot/src/xcore_discord_bot/mongo_store.py",
          "services/discord-bot/src/xcore_discord_bot/account_merge_store.py"
        ]
      },
      "x-fallback": {"plugin": "\"Not Specified\"", "bot": "MuteDoc requires it; \"Not Specified\" when blank"}
