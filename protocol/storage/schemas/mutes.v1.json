    "admin_name": {
      "type": "string",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/punishment_store.py"]
      },
      "x-read-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
