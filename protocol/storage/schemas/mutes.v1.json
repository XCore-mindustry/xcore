      },
      "x-fallback": {"plugin": "\"Unknown\"", "bot": "MuteDoc requires it; \"Unknown\" when blank"}
    },
    "admin_discord_id": {
      "type": ["string", "null"],
      "x-disagreement": "The plugin writes \"\" for no moderator id, the bot writes null.",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/punishment_store.py"]
