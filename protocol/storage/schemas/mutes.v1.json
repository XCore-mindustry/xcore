    "expire_date": {
      "$ref": "urn:xcore:storage:bson-types:v1#/$defs/date",
      "description": "Every mute expires: both writers set a date, and the bot cannot read a mute without one.",
      "x-disagreement": "The plugin's model allows a mute without expiry (Punishment.expireDate may be null, and its codec would then omit the field), but no command creates one today. The bot's MuteDoc requires a date, so such a mute would make find_mute raise.",
      "x-written-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": ["services/discord-bot/src/xcore_discord_bot/punishment_store.py"]
      },
      "x-read-by": {
        "plugin": ["plugins/xcore/src/main/java/org/xcore/plugin/model/Punishment.java"],
        "bot": [
          "services/discord-bot/src/xcore_discord_bot/store_mappers.py",
          "services/discord-bot/src/xcore_discord_bot/mongo_store.py",
          "services/discord-bot/src/xcore_discord_bot/punishment_store.py"
        ]
      }
